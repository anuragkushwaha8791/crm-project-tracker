rules_version = '2';

// =========================================================================
// MOOVING CRM - FIRESTORE SECURITY RULES (hardened, permission based)
// Publish: Firebase Console > Firestore Database > Rules > paste > Publish
// Principles: default deny, least privilege, server-side validation, no public access.
//  - Admin role  = everything except two MAIN-ONLY powers (export, aiCode).
//  - MAIN account (operations194@mooving.com) = may also export data and use AI Code Studio.
//  - Any Admin can grant individual powers to individual users (permissions/{uid}).
//    Only the MAIN account can grant or remove the two main-only powers.
// =========================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }
    function myUid() { return request.auth.uid; }
    function userPath() { return /databases/$(database)/documents/users/$(myUid()); }
    function permPath() { return /databases/$(database)/documents/permissions/$(myUid()); }

    function isAdmin() {
      return isSignedIn() && exists(userPath()) && get(userPath()).data.role == "Admin";
    }
    // a real, active CRM member (has a profile that is not disabled / deleted)
    function isMember() {
      return isSignedIn() && exists(userPath())
        && get(userPath()).data.get('disabled', false) != true
        && get(userPath()).data.get('deleted', false) != true;
    }
    function isMain() {
      return isSignedIn() && request.auth.token.email == 'operations194@mooving.com';
    }
    // granted to this user by an Admin (not counting the Admin role itself)
    function granted(p) {
      return isSignedIn() && exists(permPath()) && get(permPath()).data.perms.get(p, false) == true;
    }
    // Admins always have it, other users only when granted
    function perm(p) { return isAdmin() || granted(p); }
    // main account always has it, everybody else only when the main account granted it
    function permMain(p) { return isMain() || granted(p); }

    // ---------------- users ----------------
    match /users/{uid} {
      allow get: if isSignedIn() && (uid == myUid() || perm('adminPanel') || perm('assign') || perm('viewAll'));
      allow list: if perm('adminPanel') || perm('assign') || perm('viewAll');

      allow create: if isSignedIn() && (
        isAdmin() ||
        ( myUid() == uid
          && request.resource.data.role == "User"
          && request.resource.data.keys().hasOnly(['name','email','role','createdAt','lastLogin','gender']) )
      );

      allow update: if isSignedIn() && (
        isAdmin() ||
        ( myUid() == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastLogin','name','gender'])
          && (!('name' in request.resource.data) || (request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 80))
          && (!('gender' in request.resource.data) || request.resource.data.gender in ['male','female','']) )
      );

      allow delete: if isAdmin();
    }

    // ---------------- crmprojects ----------------
    // Owner sees/edits own projects. 'viewAll' (all Admins) sees everything.
    // create for someone else needs 'assign'. delete needs 'deleteProjects'.
    match /crmprojects/{id} {
      allow read: if isSignedIn() && (resource.data.ownerUid == myUid() || perm('viewAll'));

      allow create: if isSignedIn() && (
        ( request.resource.data.ownerUid == myUid() && !('assignedByUid' in request.resource.data) ) ||
        perm('assign')
      );

      allow update: if isSignedIn() && (
        ( resource.data.ownerUid == myUid()
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.get('assignedByUid', null) == resource.data.get('assignedByUid', null) ) ||
        isAdmin()
      );

      allow delete: if isSignedIn() && perm('deleteProjects');
    }

    // ---------------- notifications ----------------
    match /notifications/{id} {
      allow read: if isSignedIn() && (resource.data.targetUid == myUid() || perm('viewAll')
                     || (resource.data.targetUid == 'admins' && perm('requests')));

      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly(['targetUid','title','message','read','createdAt','expireAt'])
        && request.resource.data.targetUid is string
        && request.resource.data.title is string && request.resource.data.title.size() <= 300
        && request.resource.data.message is string && request.resource.data.message.size() <= 1000
        && request.resource.data.createdAt == request.time;

      allow update: if isSignedIn() && (
        isAdmin() ||
        ( resource.data.targetUid == myUid()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']) )
      );

      allow delete: if isAdmin();
    }

    // ---------------- activityLogs (append-only audit trail) ----------------
    match /activityLogs/{id} {
      allow read: if perm('activityLog');

      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly(['action','details','userEmail','userName','timestamp','expireAt'])
        && request.resource.data.action is string && request.resource.data.action.size() <= 200
        && request.resource.data.timestamp == request.time;

      allow update: if false;
      allow delete: if isAdmin();
    }

    // ---------------- settings (columns, shared AI key, AI defaults, AI options) ----------------
    // Read: real members only (no anonymous / stranger access). Write: Admin, or a user granted the matching power.
    match /settings/{id} {
      allow read: if isMember();
      allow write: if isAdmin()
        || (id == 'columns' && granted('columns'))
        || ((id == 'ai' || id == 'aiops' || id == 'aidef') && granted('aiOps'));
    }

    // ---------------- changeRequests (suggestions that wait for a reviewer) ----------------
    match /changeRequests/{id} {
      allow read: if perm('requests');

      allow create: if isMember()
        && request.resource.data.keys().hasOnly(['type','title','details','page','source','status','createdBy','createdByName','createdAt'])
        && request.resource.data.type in ['issue','feature']
        && request.resource.data.source in ['auto','user','admin','ai']
        && request.resource.data.status == 'Pending'
        && request.resource.data.createdBy == myUid()
        && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 200
        && request.resource.data.details is string && request.resource.data.details.size() <= 4000
        && request.resource.data.createdAt == request.time;

      allow update, delete: if perm('requests');
    }

    // ---------------- aiChanges (AI Code Studio audit trail) ----------------
    // Only the MAIN account, or someone the main account granted 'aiCode', can touch this.
    match /aiChanges/{id} {
      allow read, create, update: if permMain('aiCode');
      allow delete: if isMain();
    }

    // ---------------- permissions (who may do what) ----------------
    // A user can read their own powers. Only Admins can change them, and only the MAIN account
    // can grant or remove the two main-only powers (export, aiCode).
    match /permissions/{uid} {
      allow read: if isSignedIn() && (uid == myUid() || isAdmin());

      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['perms','updatedBy','updatedAt'])
        && (isMain() || (request.resource.data.perms.get('aiCode', false) == false && request.resource.data.perms.get('export', false) == false));

      allow update: if isAdmin()
        && request.resource.data.keys().hasOnly(['perms','updatedBy','updatedAt'])
        && (isMain() || (request.resource.data.perms.get('aiCode', false) == resource.data.perms.get('aiCode', false)
                         && request.resource.data.perms.get('export', false) == resource.data.perms.get('export', false)));

      allow delete: if isMain();
    }

    // ---------------- userPrefs (my pinned tasks + my own AI choices) ----------------
    match /userPrefs/{uid} {
      allow read: if isSignedIn() && (uid == myUid() || isAdmin());
      allow write: if isSignedIn() && uid == myUid()
        && request.resource.data.keys().hasOnly(['pinned','ai','look','updatedAt'])
        && (!('pinned' in request.resource.data) || (request.resource.data.pinned is list && request.resource.data.pinned.size() <= 20));
    }

    // ---------------- meta/live (real-time "something changed" signal) ----------------
    match /meta/{id} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn()
        && request.resource.data.keys().hasOnly(['ts','by'])
        && request.resource.data.ts == request.time
        && request.resource.data.by == myUid();
      allow delete: if false;
    }

    // ---------------- teams (reserved) ----------------
    match /teams/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // everything else is denied by default.
  }
}
